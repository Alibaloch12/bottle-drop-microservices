<?xml version="1.0" encoding="UTF-8"?>

<!--
    Maven Project Object Model (POM)

    This file tells Maven:
    - Which Java version to use
    - Which Spring Boot version to use
    - Which libraries (dependencies) our project needs
    - How to build and run the application
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot Parent

        Provides:
        - Dependency management
        - Compatible library versions
        - Maven plugin configuration
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <!-- Project Information -->

    <groupId>com.bottleneck</groupId>

    <artifactId>warehouse</artifactId>

    <version>0.0.1-SNAPSHOT</version>

    <name>warehouse</name>

    <description>BottleDrop Warehouse Management Microservice</description>

    <!-- Java Version -->

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
    </properties>

    <dependencies>

        <!--
            Spring Web

            Used for:
            - REST Controllers
            - HTTP Requests
            - JSON Responses
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Data JPA

            Used for:
            - Database access
            - Repository interfaces
            - ORM (Object Relational Mapping)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            H2 Database

            In-memory database used during development.
            No installation is required.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Bean Validation

            Used to validate user input.

            Example:
            @NotBlank
            @NotNull
            @Min
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!--
            Lombok

            Reduces boilerplate code by generating:
            - Getters
            - Setters
            - Constructors
            - toString()

            Note:
            If your lecturer dislikes Lombok,
            we can remove it later and write the methods ourselves.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Testing

            Provides:
            - JUnit
            - Mockito
            - Spring Boot Test
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>

        <plugins>

            <!--
                Spring Boot Maven Plugin

                Allows us to run:

                mvn spring-boot:run

                and package the application.
            -->
            <plugin>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-maven-plugin</artifactId>

            </plugin>

        </plugins>

    </build>

</project>
