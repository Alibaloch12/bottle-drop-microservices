import microservices from "./bar-management.services" as Services

import technology from "./Docker.technology" as Docker
import technology from "./Generic.technology" as Generic

@technology(Docker)
@technology(Generic)
container BarManagementContainer
    deployment technology Docker::_deployment.Docker
    deploys Services::com.example.barmanagement.BarManagementService {
        aspects {
            Docker::_aspects.Dockerfile(
                '
                FROM eclipse-temurin:26-jre-alpine
                WORKDIR /app
                RUN apk add --no-cache curl
                COPY app.jar app.jar
                EXPOSE 8083
                CMD java ${JAVA_OPTS} -jar app.jar
                '
            );
        }

        default values {
            basic endpoints {
                Generic::_protocols.http: "localhost:8083";
            }
        }
    }

@technology(Docker)
@technology(Generic)
container MySqlContainer
    deployment technology Docker::_deployment.Docker {
        aspects {
            Docker::_aspects.Dockerfile(
                '
                FROM mysql:8.0
                EXPOSE 3306
                '
            );
        }

        default values {
            basic endpoints {
                Generic::_protocols.http: "localhost:3306";
            }
        }
    }

