context UserManagementContext {
    // @Entity
    // @Table(name = "users")
    structure User {
        // @Id
        // @GeneratedValue(strategy = GenerationType.IDENTITY)
        long id,
        // @Column(nullable = false)
        string name,
        // @Column(unique = true, nullable = false)
        string email,
        // @Column(nullable = false)
        string passwordHash,
        boolean active,
        Role role
    }

    enum Role {
        ADMIN,
        PLANNER,
        BARTENDER,
        STOCKIST,
        VISITOR
    }
}
